# ==============================================================================
# SMART RESUME BUILDER - BACKEND PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=production

# Frontend Application URL (Used for CORS permissions)
# In development: http://localhost:5173
# In production on Vercel: https://your-smart-resume-builder.vercel.app
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Connection String
# Obtain from MongoDB Atlas Console -> Database -> Connect -> Drivers -> Node.js
# Replace <username>, <password>, and cluster domain with your credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_resume_builder?retryWrites=true&w=majority

# Google Gemini AI Studio API Key
# Obtain free API Key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Gemini Model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
